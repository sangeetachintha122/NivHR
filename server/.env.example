PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nivhr
ATTENDANCE_TEST_MONGO_URI=mongodb://127.0.0.1:27017
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=8h
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MS=900000
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=replace_with_a_secure_hr_password
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=replace_with_a_secure_employee_password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# In-memory Gemini breaker: state is per application process, resets on restart, and is not coordinated across Render instances.
GEMINI_CIRCUIT_BREAKER_THRESHOLD=3
GEMINI_CIRCUIT_BREAKER_COOLDOWN_MS=60000
# Cloudflare fallback sends these existing feature prompt categories only after eligible Gemini failures:
# Policy Assistant: employee question and up to four retrieved policy excerpt texts (full chunk text; no document title).
# Leave Review: reason (max 300 chars); leave type/dates/day counts; department/tenure; balances/pending counts; department capacity/headcount/daily counts; up to six policy excerpts with document titles/sections.
# HR Analytics: HR question, bounded prior user questions, reference date and planner instructions; matched employee names/emails are aliased, unmatched names may remain; database result records are not sent.
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_FALLBACK_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Application-level requests per UTC day; not Cloudflare's free allocation or a guaranteed cost ceiling.
CLOUDFLARE_DAILY_MAX_REQUESTS=100
CLOUDFLARE_REQUEST_TIMEOUT_MS=30000
RAG_MIN_SCORE=0.60
